# Copy to .env for local overrides. Never commit .env.
# Base64 is encoding, not encryption. Prefer OS/GitHub secret stores.

FPL_SETTINGS_PATH=config/settings.yaml

# Required for live pre-deadline AI + web/Reddit search via OpenAI
# OPENAI_API_KEY=sk-...

# Optional overrides (examples only — never put live secrets here)
# FPL_MANAGER__TEAM_ID=3051887
# FPL_PRIVATE_STATE_B64=
# GITHUB_TOKEN=
